cabal-version:   3.0
name:            myque-gh
version:         0.1.0.0
synopsis:        Project canonical myque work items into GitHub
license:         BSD-3-Clause
author:          Brian Duan
maintainer:      iceice666@outlook.com
build-type:      Simple

common warnings
  ghc-options:
    -Wall -Wcompat -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  exposed-modules:
    Myque.Github.Cli
    Myque.Github.Github
    Myque.Github.Markers
    Myque.Github.Projection
    Myque.Github.Reconcile
    Myque.Github.Source
    Myque.Github.Types
  hs-source-dirs:   src
  default-language: GHC2021
  build-depends:
    , aeson                >=2.2  && <2.3
    , base                 >=4.18 && <5
    , bytestring           >=0.11 && <0.13
    , containers           >=0.6  && <0.9
    , directory            >=1.3  && <1.4
    , filelock             >=0.1  && <0.2
    , filepath             >=1.4  && <1.6
    , myque                ==0.1.0.0
    , optparse-applicative >=0.18 && <0.20
    , temporary            >=1.3  && <1.4
    , text                 >=2.0  && <2.2
    , typed-process        >=0.2  && <0.3

executable myque-gh
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  ghc-options:      -threaded
  build-depends:
    , base
    , myque-gh

test-suite myque-gh-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  default-language: GHC2021
  build-depends:
    , aeson
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , hspec      >=2.11 && <2.12
    , myque
    , myque-gh
    , process    >=1.6  && <1.7
    , temporary
    , text

executable myque-gh-hosted-smoke
  import:           warnings
  main-is:          HostedSmoke.hs
  hs-source-dirs:   test
  default-language: GHC2021
  scope:            private
  build-tool-depends: myque-gh:myque-gh
  build-depends:
    , base
    , containers
    , myque
    , process
    , temporary
    , text
